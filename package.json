{
  "name": "beautystore-hibrida",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Migración académica de Beauty Store (Kotlin) a Ionic + Capacitor para Android, iOS y web",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "api": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "ios": "npm run build && npx cap sync ios && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@ionic/core": "^8.0.0",
    "firebase": "^12.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "vite": "^7.0.0",
    "vite-plugin-static-copy": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
