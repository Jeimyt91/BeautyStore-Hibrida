# Configuración de la aplicación web Firebase creada en Firebase Console.
# NO copie el google-services.json de Android en estas variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Opcional: URL pública o local del servidor API. Se puede cambiar en Ajustes.
# Para navegador local: http://localhost:3000
# Para celular físico: http://IP_DE_TU_COMPUTADOR:3000
VITE_API_URL=
